{
  "name": "muscat-board",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run check:types && tsx build.ts",
    "format": "oxfmt .",
    "lint:fix": "eslint . --fix",
    "check": "concurrently -c auto 'npm:check:*'",
    "check:format": "oxfmt --check .",
    "check:lint": "eslint .",
    "check:knip": "knip",
    "check:fallow": "fallow audit",
    "check:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.9.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "fallow": "^2.69.0",
    "globals": "^17.6.0",
    "knip": "^6.12.2",
    "oxfmt": "^0.48.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.2"
  }
}
